# https://www.alphavantage.co/support/#api-key (free: 25 requests/day)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
# https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here
# Tried in order, the next one is used if a model is busy
GEMINI_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest

PORT=3000
